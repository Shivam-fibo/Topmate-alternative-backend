  return prisma.onboardingCategory.findUnique({
    where: {
      slug,
    },
  });
};

export const getAllOnboardingCategories = () => {
  return prisma.onboardingCategory.findMany({
    orderBy: {
      createdAt: "desc",
    },
  });
};

export const getActiveOnboardingCategories = () => {
  return prisma.onboardingCategory.findMany({
    where: {
      isActive: true,
    },

    orderBy: {
      createdAt: "desc",
    },
  });
};
