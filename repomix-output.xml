<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleType {
  USER
  MENTOR
  ADMIN
}

enum MentorOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MentorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SchedulingConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  DISCONNECTED
}

enum OnboardingFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  FILE
}

enum OnboardingSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorProfileStatus {
  PUBLIC
  PRIVATE
  SUSPENDED
}












// -----------------------------------------------------MODELS--------------------------------------------------

model User {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String

  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile? @relation("UserMentorProfile")

  roles    UserRole[]
  sessions Session[]

  emailVerifications   EmailVerificationToken[]
  passwordResets       PasswordResetToken[]
  OnboardingSubmission OnboardingSubmission[]

  @@index([email])
}

model Role {
  id String @id @default(cuid())

  name RoleType @unique

  createdAt DateTime @default(now())

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id String @id @default(cuid())

  userId String

  refreshTokenHash String
  tokenVersion     Int    @default(0)

  userAgent String?
  ipAddress String?

  expiresAt DateTime

  lastUsedAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String

  tokenHash String

  expiresAt DateTime

  usedAt DateTime?

  createdAt    DateTime @default(now())
  attemptCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  tokenHash String

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MentorProfile {
  id String @id @default(cuid())

  userId String @unique

  slug String @unique

  headline String?

  bio String?

  profileImageUrl String?

  expertiseTags Json?

  socialLinks Json?

  status MentorProfileStatus @default(PRIVATE)

  isVerified Boolean @default(false)

  suspendedReason String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation( "UserMentorProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])

  @@index([status])

  @@index([isVerified])
}

// onboarding categories for mentors
model OnboardingCategory {
  id String @id @default(cuid())

  name String @unique

  slug String @unique

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  fields               OnboardingField[]
  OnboardingSubmission OnboardingSubmission[]
}

model OnboardingField {
  id String @id @default(cuid())

  categoryId String

  label String

  fieldKey String @unique

  fieldType OnboardingFieldType

  placeholder String?

  helpText String?

  isRequired Boolean @default(false)

  sortOrder Int

  isActive Boolean @default(true)

  options Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  category                   OnboardingCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  OnboardingSubmissionAnswer OnboardingSubmissionAnswer[]

  @@index([categoryId])
}

model OnboardingSubmission {
  id String @id @default(cuid())

  userId String

  categoryId String

  status OnboardingSubmissionStatus @default(PENDING)

  submittedAt DateTime @default(now())

  reviewedAt DateTime?

  reviewNotes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  category OnboardingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  answers OnboardingSubmissionAnswer[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
}

model OnboardingSubmissionAnswer {
  id String @id @default(cuid())

  submissionId String

  fieldId String

  value Json

  createdAt DateTime @default(now())

  submission OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  field OnboardingField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([fieldId])
}
